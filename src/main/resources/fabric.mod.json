{
	"schemaVersion": 1,
	"id": "tan_adastra_compat",
	"version": "${version}",
	"name": "TAN AdAstra Compat",
	"description": "A simple mod that adds compatibility between ToughAsNails and AdAstra",
	"authors": [
		"Pluto7073"
	],
	"contact": {
		"homepage": "https://github.com/pluto7073/TAN-AdAstra-Compat/tree/1.20/",
		"sources": "https://github.com/pluto7073/TAN-AdAstra-Compat/tree/1.20"
	},
	"license": "MIT",
	"icon": "assets/tan_adastra_compat/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.example.ExampleMod"
		],
		"client": [
			"com.example.client.ExampleModClient"
		]
	},
	"mixins": [
		"modid.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=17",
		"fabric-api": ">=${fabric_api_version"
	},
	"suggests": {
		"another-mod": "*"
	}
